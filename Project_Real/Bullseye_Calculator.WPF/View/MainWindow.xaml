<Window x:Class="Bullseye_Calculator.WPF.View.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:Bullseye_Calculator.WPF.View"
		mc:Ignorable="d"
		Title="Bullseye Calculator" Height="340" Width="260" MinHeight="340" MinWidth="260"> <!-- Icon="/Icon/icon.ico"> -->
	<Grid Background="#232323">
		<Grid.RowDefinitions>
			<RowDefinition Height="3*" />
			<RowDefinition />
			<RowDefinition Height="6*" />
		</Grid.RowDefinitions>

		<Label Grid.Row="0" Content="{Binding Input}" />

		<Grid Grid.Row="1">
			<Grid.RowDefinitions>
				<RowDefinition />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="4*" />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>

			<Expander Grid.Column="0" x:Name="History" Header="Steps" ExpandDirection="Up" />
			<Button Grid.Column="1" Content="[ ]" />
			<Button Grid.Column="2" Content="I" />
			<Button Grid.Column="3" Content="∫" />
		</Grid>

		<ListView Grid.Row="2" Style="{Binding Source={StaticResource ExpandableList}}" ItemsSource="{Binding Evaluation}" />

		<Grid Grid.Row="2">
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>

			<Button Grid.Row="5" Grid.Column="2" Content="0" Command="{Binding InputCommand}" CommandParameter="0" />
			<Button Grid.Row="4" Grid.Column="1" Content="1" Command="{Binding InputCommand}" CommandParameter="1" />
			<Button Grid.Row="4" Grid.Column="2" Content="2" Command="{Binding InputCommand}" CommandParameter="2" />
			<Button Grid.Row="4" Grid.Column="3" Content="3" Command="{Binding InputCommand}" CommandParameter="3" />
			<Button Grid.Row="3" Grid.Column="1" Content="4" Command="{Binding InputCommand}" CommandParameter="4" />
			<Button Grid.Row="3" Grid.Column="2" Content="5" Command="{Binding InputCommand}" CommandParameter="5" />
			<Button Grid.Row="3" Grid.Column="3" Content="6" Command="{Binding InputCommand}" CommandParameter="6" />
			<Button Grid.Row="2" Grid.Column="1" Content="7" Command="{Binding InputCommand}" CommandParameter="7" />
			<Button Grid.Row="2" Grid.Column="2" Content="8" Command="{Binding InputCommand}" CommandParameter="8" />
			<Button Grid.Row="2" Grid.Column="3" Content="9" Command="{Binding InputCommand}" CommandParameter="9" />

			<Button Grid.Row="0" Grid.Column="5" Content="%" Command="{Binding InputCommand}" CommandParameter="%" />
			<Button Grid.Row="1" Grid.Column="5" Content="/" Command="{Binding InputCommand}" CommandParameter="/" />
			<Button Grid.Row="2" Grid.Column="5" Content="×" Command="{Binding InputCommand}" CommandParameter="*" />
			<Button Grid.Row="3" Grid.Column="5" Content="–" Command="{Binding InputCommand}" CommandParameter="-" />
			<Button Grid.Row="4" Grid.Column="5" Content="+" Command="{Binding InputCommand}" CommandParameter="+" />
			<Button Grid.Row="5" Grid.Column="5" Content="=" Command="{Binding EvaluateCommand}" />
			<!--CommandParameter="="-->

			<Button Grid.Row="5" Grid.Column="1" Content="␣" Command="{Binding InputCommand}" CommandParameter=" " />
			<Button Grid.Row="5" Grid.Column="3" Content="." Command="{Binding InputCommand}" CommandParameter="." />
			<Button Grid.Row="0" Grid.Column="1" Content="(" Command="{Binding InputCommand}" CommandParameter="(" />
			<Button Grid.Row="0" Grid.Column="2" Content=")" Command="{Binding InputCommand}" CommandParameter=")" />

			<Button Grid.Row="0" Grid.Column="0" Content="x²" Command="{Binding InputCommand}" CommandParameter="^2" />
			<Button Grid.Row="1" Grid.Column="0" Content="xⁿ" Command="{Binding InputCommand}" CommandParameter="^" />
			<Button Grid.Row="2" Grid.Column="0" Content="!x" Command="{Binding InputCommand}" CommandParameter="!" />
			<Button Grid.Row="3" Grid.Column="0" Content="√x" Command="{Binding InputCommand}" CommandParameter="2|" />
			<Button Grid.Row="4" Grid.Column="0" Content="ⁿ√x" Command="{Binding InputCommand}" CommandParameter="|" />
			<Button Grid.Row="5" Grid.Column="0" Content="|x|" Command="{Binding InputCommand}" CommandParameter="abs("/>

			<Button Grid.Row="1" Grid.Column="1" Content="π" Command="{Binding InputCommand}" CommandParameter="pi" />
			<Button Grid.Row="1" Grid.Column="2" Content="e" Command="{Binding InputCommand}" CommandParameter="e" />

			<Button Grid.Row="0" Grid.Column="3" Content="C" Command="{Binding ClearCommand}" />
			<Button Grid.Row="1" Grid.Column="3" Content="⇦" Command="{Binding BackSpaceCommand}" />
		</Grid>
	</Grid>
</Window>