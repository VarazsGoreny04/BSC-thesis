<Window x:Class="BullseyeCalculator.WPF.View.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:viewmodel="clr-namespace:BullseyeCalculator.WPF.ViewModel"
		d:DataContext="{d:DesignInstance Type=viewmodel:CalculatorViewModel}"
		mc:Ignorable="d"
		Title="Bullseye Calculator" Height="340" Width="260" MinHeight="340" MinWidth="260" >
	<Grid Background="{StaticResource BackgroundBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="3*" />
			<RowDefinition />
			<RowDefinition Height="6*" />
		</Grid.RowDefinitions>

		<Grid x:Name="Options" Background="{StaticResource BackgroundBrush}" Panel.ZIndex="2" Grid.Row="0" Grid.RowSpan="3">
			<Grid.Style>
				<Style TargetType="Grid">
					<Setter Property="Visibility" Value="Hidden" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding ShowOptions}" Value="True">
							<Setter Property="Visibility" Value="Visible" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Grid.Style>
			
			<Grid.RowDefinitions>
				<RowDefinition Height="2*" />
				<RowDefinition />
				<RowDefinition Height="2*" />
				<RowDefinition />
				<RowDefinition Height="2*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="auto" />
				<ColumnDefinition Width="auto" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>

			<Label Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Content="Use fractional format " />
			<CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding FractionalFormat}"  HorizontalAlignment="Center" VerticalAlignment="Center" />

			<Label Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Content="Fractional accuracy " />
			<Grid Grid.Row="2" Grid.Column="2" MinWidth="30">
				<Grid.RowDefinitions>
					<RowDefinition/>
					<RowDefinition/>
					<RowDefinition/>
				</Grid.RowDefinitions>

				<Button Content="▲" Grid.Row="0" Style="{StaticResource LightButton}" Command="{Binding IncreaseFractionCalculationLengthCommand}" />
				
				<Border BorderThickness="1" BorderBrush="Gray" Margin="2,2,2,2" Grid.Row="1" 
					VerticalAlignment="Center" HorizontalAlignment="Stretch">

					<!--Bind the TextBlock to the Value property-->
					<Label Content="{Binding FractionCalculationLength}" HorizontalAlignment="Center" VerticalAlignment="Center" />
				</Border>

				<Button Content="▼" Grid.Row="2" Style="{StaticResource LightButton}" Command="{Binding DecreaseFractionCalculationLengthCommand}" />
			</Grid>

			<Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" >
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition Width="auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Button Grid.Column="1" Content="Apply" Style="{StaticResource SpecialButton}" Command="{Binding ShowOptionsCommand}" />
			</Grid>
		</Grid>

		<Border Grid.Row="0" Style="{StaticResource RoundedBorderStyle}" >
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="2*" />
					<RowDefinition />
				</Grid.RowDefinitions>

				<Label Grid.Row="0" Content="{Binding Input}" />
				<Label Grid.Row="1" Content="{Binding Result}" />
			</Grid>
		</Border>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="3*" />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>

			<Button Grid.Column="0" Command="{Binding ShowStepsCommand}">
				<Button.Style>
					<Style TargetType="Button" BasedOn="{StaticResource SpecialButton}">
						<Style.Triggers>
							<DataTrigger Binding="{Binding ShowSteps}" Value="False">
								<Setter Property="Content" Value="🔽Steps" />
							</DataTrigger>
							<DataTrigger Binding="{Binding ShowSteps}" Value="True">
								<Setter Property="Content" Value="🔼Steps" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
			</Button>
			<Button Grid.Column="2" Content="S" Command="{Binding StandardModeCommand}">
				<Button.Style>
					<Style TargetType="Button" BasedOn="{StaticResource LightButton}">
						<Style.Triggers>
							<DataTrigger Binding="{Binding CurrentMode}" Value="Standard">
								<Setter Property="IsEnabled" Value="False" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
			</Button>
			<Button Grid.Column="3" Content="[]" Command="{Binding EuclideanModeCommand}">
				<Button.Style>
					<Style TargetType="Button" BasedOn="{StaticResource LightButton}">
						<Style.Triggers>
							<DataTrigger Binding="{Binding CurrentMode}" Value="Matrix">
								<Setter Property="IsEnabled" Value="False" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
			</Button>
			<Button Grid.Column="4" Content="I" Command="{Binding InterpolationModeCommand}">
				<Button.Style>
					<Style TargetType="Button" BasedOn="{StaticResource LightButton}">
						<Style.Triggers>
							<DataTrigger Binding="{Binding CurrentMode}" Value="Interpolation">
								<Setter Property="IsEnabled" Value="False" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
			</Button>
			<Button Grid.Column="5" Content="⚙️" Command="{Binding ShowOptionsCommand}">
				<Button.Style>
					<Style TargetType="Button" BasedOn="{StaticResource SpecialButton}">
						<Setter Property="IsEnabled" Value="True" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding CurrentMode}" Value="Options">
								<Setter Property="IsEnabled" Value="False" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
			</Button>
		</Grid>

		<ListView Grid.Row="2" ItemsSource="{Binding Evaluation}" />

		<Grid x:Name="Keys" Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition>
					<ColumnDefinition.Style>
						<Style TargetType="ColumnDefinition">
							<Setter Property="Width" Value="auto" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding CurrentMode}" Value="Matrix">
									<Setter Property="Width" Value="1*" />
								</DataTrigger>
								<DataTrigger Binding="{Binding CurrentMode}" Value="Interpolation">
									<Setter Property="Width" Value="1*" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</ColumnDefinition.Style>
				</ColumnDefinition>
				<ColumnDefinition Width="5*" />
			</Grid.ColumnDefinitions>

			<Grid x:Name="MatrixKeys" Grid.Column="0">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>

				<Button Grid.Row="0" Content="[" Style="{StaticResource SpecialButton}" Command="{Binding PushInputCommand}" CommandParameter="[" />
				<Button Grid.Row="1" Content="]" Style="{StaticResource SpecialButton}" Command="{Binding PushInputCommand}" CommandParameter="]" />
				<Button Grid.Row="2" Content="{Binding ColumnSeparator}" Style="{StaticResource SpecialButton}" Command="{Binding PushInputCommand}" CommandParameter="{Binding ColumnSeparator}" />
				<Button Grid.Row="3" Content="{Binding RowSeparator}" Style="{StaticResource SpecialButton}" Command="{Binding PushInputCommand}" CommandParameter="{Binding RowSeparator}" />
				<Button Grid.Row="4" Content="[⋱]" Style="{StaticResource SpecialButton}" Command="{Binding PushInputCommand}" CommandParameter="diag(" />
				<Button Grid.Row="5" Content="[]⁻¹" Style="{StaticResource SpecialButton}" Command="{Binding PushInputCommand}" CommandParameter="inv(" />

				<Grid.Style>
					<Style TargetType="Grid">
						<Setter Property="Visibility" Value="Collapsed" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding CurrentMode}" Value="Matrix">
								<Setter Property="Visibility" Value="Visible" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Grid.Style>
			</Grid>

			<Grid x:Name="InterpolationKeys" Grid.Column="0">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>

				<Button Grid.Row="0" Content="[" Style="{StaticResource SpecialButton}" Command="{Binding PushInputCommand}" CommandParameter="[" />
				<Button Grid.Row="1" Content="]" Style="{StaticResource SpecialButton}" Command="{Binding PushInputCommand}" CommandParameter="]" />
				<Button Grid.Row="2" Content="{Binding ColumnSeparator}" Style="{StaticResource SpecialButton}" Command="{Binding PushInputCommand}" CommandParameter="{Binding ColumnSeparator}" />
				<Button Grid.Row="3" Content="{Binding RowSeparator}" Style="{StaticResource SpecialButton}" Command="{Binding PushInputCommand}" CommandParameter="{Binding RowSeparator}" />

				<Grid.Style>
					<Style TargetType="Grid">
						<Setter Property="Visibility" Value="Collapsed" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding CurrentMode}" Value="Interpolation">
								<Setter Property="Visibility" Value="Visible" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Grid.Style>
			</Grid>

			<Grid x:Name="StandardKeys" Grid.Column="1">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition />
					<ColumnDefinition />
					<ColumnDefinition />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Button Grid.Row="5" Grid.Column="2" Content="0" Style="{StaticResource LightButton}" Command="{Binding PushInputCommand}" CommandParameter="0" />
				<Button Grid.Row="4" Grid.Column="1" Content="1" Style="{StaticResource LightButton}" Command="{Binding PushInputCommand}" CommandParameter="1" />
				<Button Grid.Row="4" Grid.Column="2" Content="2" Style="{StaticResource LightButton}" Command="{Binding PushInputCommand}" CommandParameter="2" />
				<Button Grid.Row="4" Grid.Column="3" Content="3" Style="{StaticResource LightButton}" Command="{Binding PushInputCommand}" CommandParameter="3" />
				<Button Grid.Row="3" Grid.Column="1" Content="4" Style="{StaticResource LightButton}" Command="{Binding PushInputCommand}" CommandParameter="4" />
				<Button Grid.Row="3" Grid.Column="2" Content="5" Style="{StaticResource LightButton}" Command="{Binding PushInputCommand}" CommandParameter="5" />
				<Button Grid.Row="3" Grid.Column="3" Content="6" Style="{StaticResource LightButton}" Command="{Binding PushInputCommand}" CommandParameter="6" />
				<Button Grid.Row="2" Grid.Column="1" Content="7" Style="{StaticResource LightButton}" Command="{Binding PushInputCommand}" CommandParameter="7" />
				<Button Grid.Row="2" Grid.Column="2" Content="8" Style="{StaticResource LightButton}" Command="{Binding PushInputCommand}" CommandParameter="8" />
				<Button Grid.Row="2" Grid.Column="3" Content="9" Style="{StaticResource LightButton}" Command="{Binding PushInputCommand}" CommandParameter="9" />

				<Button Grid.Row="0" Grid.Column="5" Content="%" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="%" />
				<Button Grid.Row="1" Grid.Column="5" Content="/" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="/" />
				<Button Grid.Row="2" Grid.Column="5" Content="×" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="*" />
				<Button Grid.Row="3" Grid.Column="5" Content="–" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="-" />
				<Button Grid.Row="4" Grid.Column="5" Content="+" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="+" />
				<Button Grid.Row="5" Grid.Column="5" Content="=" Style="{StaticResource SpecialButton}" Command="{Binding EvaluateCommand}" />

				<Button Grid.Row="5" Grid.Column="1" Content="␣" Style="{StaticResource LightButton}" Command="{Binding PushInputCommand}" CommandParameter=" " />
				<Button Grid.Row="5" Grid.Column="3" Content="{Binding Separator}" Command="{Binding PushInputCommand}" Style="{StaticResource LightButton}" 
				CommandParameter="{Binding Separator}" />

				<Button Grid.Row="0" Grid.Column="1" Content="(" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="(" />
				<Button Grid.Row="0" Grid.Column="2" Content=")" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter=")" />

				<Expander Grid.Row="0" Grid.Column="0" Header="⨍">
					<StackPanel>
						<Button Content="|x|" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="abs("/>
						<Button Content="!x" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="fact(" />
					</StackPanel>
				</Expander>
				<Expander Grid.Row="1" Grid.Column="0" Header="📐">
					<StackPanel>
						<Button Content="sin" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="sin(" />
						<Button Content="cos" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="cos(" />
						<Button Content="eˣ" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="exp(" />
						<Button Content="ln" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="ln(" />
					</StackPanel>
				</Expander>

				<Button Grid.Row="2" Grid.Column="0" Content="x²" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="^2" />
				<Button Grid.Row="3" Grid.Column="0" Content="xⁿ" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="^" />
				<Button Grid.Row="4" Grid.Column="0" Content="√x" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="2|" />
				<Button Grid.Row="5" Grid.Column="0" Content="ⁿ√x" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="|" />

				<Button Grid.Row="1" Grid.Column="1" Content="π" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="pi" />
				<Button Grid.Row="1" Grid.Column="2" Content="e" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="e" />

				<Button Grid.Row="0" Grid.Column="3" Content="C" Style="{StaticResource DarkButton}" Command="{Binding ClearInputCommand}" />
				<Button Grid.Row="1" Grid.Column="3" Content="⌫" Style="{StaticResource DarkButton}" Command="{Binding PopInputCommand}" />
			</Grid>
		</Grid>
	</Grid>
</Window>