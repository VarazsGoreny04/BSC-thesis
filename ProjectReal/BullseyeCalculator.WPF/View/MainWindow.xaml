<Window x:Class="BullseyeCalculator.WPF.View.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:viewmodel="clr-namespace:BullseyeCalculator.WPF.ViewModel"
		d:DataContext="{d:DesignInstance Type=viewmodel:CalculatorViewModel}"
		mc:Ignorable="d"
		Title="Bullseye Calculator" Height="340" Width="260" MinHeight="340" MinWidth="260">
	<Grid Background="{StaticResource BackgroundBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="3*" />
			<RowDefinition />
			<RowDefinition Height="6*" />
		</Grid.RowDefinitions>

		<Grid x:Name="Options" Background="{StaticResource BackgroundBrush}" Panel.ZIndex="2" Grid.Row="0" Grid.RowSpan="3">
			<Grid.Style>
				<Style TargetType="Grid">
					<Setter Property="Visibility" Value="Hidden" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding ShowOptions}" Value="True">
							<Setter Property="Visibility" Value="Visible" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Grid.Style>
			
			<Grid.RowDefinitions>
				<RowDefinition Height="4*" />
				<RowDefinition Height="2*" />
				<RowDefinition Height="4*" />
				<RowDefinition />
				<RowDefinition Height="2*" />
				<RowDefinition Height="4*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="auto" />
				<ColumnDefinition MinWidth="30" MaxWidth="150" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>

			<Label Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Content="Use fractional format " FontSize="{DynamicResource ControlFontSize}" />
			<Viewbox Grid.Row="1" Grid.Column="2" Width="{DynamicResource ControlFontSize}" Height="{DynamicResource ControlFontSize}" >
				<CheckBox IsChecked="{Binding FractionalFormat}" />
			</Viewbox>

			<Label Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Content="Fractional accuracy " FontSize="{DynamicResource ControlFontSize}" />
			<Grid Grid.Row="2" Grid.Column="2" MinWidth="30">
				<Grid.RowDefinitions>
					<RowDefinition/>
					<RowDefinition/>
					<RowDefinition/>
				</Grid.RowDefinitions>

				<Button Content="▲" Grid.Row="0" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource LightButton}" Command="{Binding IncreaseFractionCalculationLengthCommand}" />
				
				<Border BorderThickness="1" BorderBrush="Gray" Margin="2,2,2,2" Grid.Row="1" 
					VerticalAlignment="Center" HorizontalAlignment="Stretch">

					<!--Bind the TextBlock to the Value property-->
					<Label Content="{Binding FractionCalculationLength}" FontSize="{DynamicResource ControlFontSize}" HorizontalAlignment="Center" VerticalAlignment="Center" />
				</Border>

				<Button Content="▼" Grid.Row="2" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource LightButton}" Command="{Binding DecreaseFractionCalculationLengthCommand}" />
			</Grid>

			<Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" >
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="3*" />
					<ColumnDefinition Width="2*" />
					<ColumnDefinition Width="3*" />
				</Grid.ColumnDefinitions>

				<Button Grid.Column="1" Content="Apply" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource SpecialButton}" Command="{Binding ShowOptionsCommand}" />
			</Grid>
		</Grid>

		<Border Grid.Row="0" Style="{StaticResource RoundedBorderStyle}" >
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="2*" />
					<RowDefinition />
				</Grid.RowDefinitions>

				<Label Grid.Row="0" FontSize="{DynamicResource ControlFontSize}" Content="{Binding Input}" />
				<Label Grid.Row="1" FontSize="{DynamicResource ControlFontSize}" Content="{Binding Result}" />
			</Grid>
		</Border>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="3*" />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>

			<Button Grid.Column="0" FontSize="{DynamicResource ControlFontSize}" Command="{Binding ShowStepsCommand}">
				<Button.Style>
					<Style TargetType="Button" BasedOn="{StaticResource SpecialButton}">
						<Style.Triggers>
							<DataTrigger Binding="{Binding ShowSteps}" Value="False">
								<Setter Property="Content" Value="🔽Steps" />
							</DataTrigger>
							<DataTrigger Binding="{Binding ShowSteps}" Value="True">
								<Setter Property="Content" Value="🔼Steps" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
			</Button>
			<Button Grid.Column="2" Content="S" FontSize="{DynamicResource ControlFontSize}" Command="{Binding StandardModeCommand}">
				<Button.Style>
					<Style TargetType="Button" BasedOn="{StaticResource LightButton}">
						<Style.Triggers>
							<DataTrigger Binding="{Binding CurrentMode}" Value="Standard">
								<Setter Property="IsEnabled" Value="False" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
			</Button>
			<Button Grid.Column="3" Content="[]" FontSize="{DynamicResource ControlFontSize}" Command="{Binding EuclideanModeCommand}">
				<Button.Style>
					<Style TargetType="Button" BasedOn="{StaticResource LightButton}">
						<Style.Triggers>
							<DataTrigger Binding="{Binding CurrentMode}" Value="Matrix">
								<Setter Property="IsEnabled" Value="False" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
			</Button>
			<Button Grid.Column="4" Content="I" FontSize="{DynamicResource ControlFontSize}" Command="{Binding InterpolationModeCommand}">
				<Button.Style>
					<Style TargetType="Button" BasedOn="{StaticResource LightButton}">
						<Style.Triggers>
							<DataTrigger Binding="{Binding CurrentMode}" Value="Interpolation">
								<Setter Property="IsEnabled" Value="False" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
			</Button>
			<Button Grid.Column="5" Content="⚙️" FontSize="{DynamicResource ControlFontSize}" Command="{Binding ShowOptionsCommand}">
				<Button.Style>
					<Style TargetType="Button" BasedOn="{StaticResource SpecialButton}">
						<Setter Property="IsEnabled" Value="True" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding CurrentMode}" Value="Options">
								<Setter Property="IsEnabled" Value="False" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
			</Button>
		</Grid>

		<ListView Grid.Row="2" ItemsSource="{Binding Evaluation}" FontSize="{DynamicResource ControlFontSize}" />

		<Grid x:Name="Keys" Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition>
					<ColumnDefinition.Style>
						<Style TargetType="ColumnDefinition">
							<Setter Property="Width" Value="auto" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding CurrentMode}" Value="Matrix">
									<Setter Property="Width" Value="1*" />
								</DataTrigger>
								<DataTrigger Binding="{Binding CurrentMode}" Value="Interpolation">
									<Setter Property="Width" Value="1*" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</ColumnDefinition.Style>
				</ColumnDefinition>
				<ColumnDefinition Width="5*" />
			</Grid.ColumnDefinitions>

			<Grid x:Name="MatrixKeys" Grid.Column="0">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>

				<Button Grid.Row="0" Content="[" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource SpecialButton}" Command="{Binding PushInputCommand}" CommandParameter="[" />
				<Button Grid.Row="1" Content="]" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource SpecialButton}" Command="{Binding PushInputCommand}" CommandParameter="]" />
				<Button Grid.Row="2" Content="{Binding ColumnSeparator}" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource SpecialButton}" Command="{Binding PushInputCommand}" CommandParameter="{Binding ColumnSeparator}" />
				<Button Grid.Row="3" Content="{Binding RowSeparator}" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource SpecialButton}" Command="{Binding PushInputCommand}" CommandParameter="{Binding RowSeparator}" />
				<Button Grid.Row="4" Content="[⋱]" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource SpecialButton}" Command="{Binding PushInputCommand}" CommandParameter="diag(" />
				<Button Grid.Row="5" Content="[]⁻¹" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource SpecialButton}" Command="{Binding PushInputCommand}" CommandParameter="inv(" />

				<Grid.Style>
					<Style TargetType="Grid">
						<Setter Property="Visibility" Value="Collapsed" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding CurrentMode}" Value="Matrix">
								<Setter Property="Visibility" Value="Visible" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Grid.Style>
			</Grid>

			<Grid x:Name="InterpolationKeys" Grid.Column="0">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>

				<Button Grid.Row="0" Content="[" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource SpecialButton}" Command="{Binding PushInputCommand}" CommandParameter="[" />
				<Button Grid.Row="1" Content="]" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource SpecialButton}" Command="{Binding PushInputCommand}" CommandParameter="]" />
				<Button Grid.Row="2" Content="{Binding ColumnSeparator}" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource SpecialButton}" Command="{Binding PushInputCommand}" CommandParameter="{Binding ColumnSeparator}" />
				<Button Grid.Row="3" Content="{Binding RowSeparator}" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource SpecialButton}" Command="{Binding PushInputCommand}" CommandParameter="{Binding RowSeparator}" />

				<Grid.Style>
					<Style TargetType="Grid">
						<Setter Property="Visibility" Value="Collapsed" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding CurrentMode}" Value="Interpolation">
								<Setter Property="Visibility" Value="Visible" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Grid.Style>
			</Grid>

			<Grid x:Name="StandardKeys" Grid.Column="1">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition />
					<ColumnDefinition />
					<ColumnDefinition />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Button Grid.Row="5" Grid.Column="2" Content="0" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource LightButton}" Command="{Binding PushInputCommand}" CommandParameter="0" />
				<Button Grid.Row="4" Grid.Column="1" Content="1" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource LightButton}" Command="{Binding PushInputCommand}" CommandParameter="1" />
				<Button Grid.Row="4" Grid.Column="2" Content="2" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource LightButton}" Command="{Binding PushInputCommand}" CommandParameter="2" />
				<Button Grid.Row="4" Grid.Column="3" Content="3" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource LightButton}" Command="{Binding PushInputCommand}" CommandParameter="3" />
				<Button Grid.Row="3" Grid.Column="1" Content="4" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource LightButton}" Command="{Binding PushInputCommand}" CommandParameter="4" />
				<Button Grid.Row="3" Grid.Column="2" Content="5" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource LightButton}" Command="{Binding PushInputCommand}" CommandParameter="5" />
				<Button Grid.Row="3" Grid.Column="3" Content="6" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource LightButton}" Command="{Binding PushInputCommand}" CommandParameter="6" />
				<Button Grid.Row="2" Grid.Column="1" Content="7" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource LightButton}" Command="{Binding PushInputCommand}" CommandParameter="7" />
				<Button Grid.Row="2" Grid.Column="2" Content="8" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource LightButton}" Command="{Binding PushInputCommand}" CommandParameter="8" />
				<Button Grid.Row="2" Grid.Column="3" Content="9" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource LightButton}" Command="{Binding PushInputCommand}" CommandParameter="9" />

				<Button Grid.Row="0" Grid.Column="5" Content="%" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="%" />
				<Button Grid.Row="1" Grid.Column="5" Content="/" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="/" />
				<Button Grid.Row="2" Grid.Column="5" Content="×" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="*" />
				<Button Grid.Row="3" Grid.Column="5" Content="–" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="-" />
				<Button Grid.Row="4" Grid.Column="5" Content="+" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="+" />
				<Button Grid.Row="5" Grid.Column="5" Content="=" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource SpecialButton}" Command="{Binding EvaluateCommand}" />

				<Button Grid.Row="5" Grid.Column="1" Content="␣" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource LightButton}" Command="{Binding PushInputCommand}" CommandParameter=" " />
				<Button Grid.Row="5" Grid.Column="3" Content="{Binding Separator}" Command="{Binding PushInputCommand}" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource LightButton}" 
				CommandParameter="{Binding Separator}" />

				<Button Grid.Row="0" Grid.Column="1" Content="(" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="(" />
				<Button Grid.Row="0" Grid.Column="2" Content=")" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter=")" />

				<Button Grid.Row="0" Grid.Column="0" Content="{Binding CurrentPanelName}" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource SpecialButton}" Command="{Binding CyclePanelCommand}" />

				<Grid x:Name="ExponentialFunctionKeys" Grid.Row="1" Grid.RowSpan="4" Grid.Column="0">
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>

					<Button Grid.Row="0" Content="x²" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="^2" />
					<Button Grid.Row="1" Content="xⁿ" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="^" />
					<Button Grid.Row="2" Content="√x" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="2|" />
					<Button Grid.Row="3" Content="ⁿ√x" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="|" />

					<Grid.Style>
						<Style TargetType="Grid">
							<Setter Property="Visibility" Value="Hidden" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding CurrentPanel}" Value="ExponentialFunctions">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Grid.Style>
				</Grid>

				<Grid x:Name="StandardFunctionKeys" Grid.Row="1" Grid.RowSpan="4" Grid.Column="0">
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<!-- <RowDefinition />
						<RowDefinition /> -->
					</Grid.RowDefinitions>

					<!-- <Button Grid.Row="0" Content="⌊x⌉" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="round(" /> -->
					<Button Grid.Row="0" Content="⌊x⌋" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="floor(" />
					<Button Grid.Row="1" Content="⌈x⌉" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="ceiling(" />
					<Button Grid.Row="2" Content="min" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="min(" />
					<Button Grid.Row="3" Content="max" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="max(" />
					<!-- <Button Grid.Row="5" Content="|x|" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="abs(" /> -->

					<Grid.Style>
						<Style TargetType="Grid">
							<Setter Property="Visibility" Value="Hidden" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding CurrentPanel}" Value="StandardFunctions">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Grid.Style>
				</Grid>

				<Grid x:Name="SpecialFunctionKeys" Grid.Row="1" Grid.RowSpan="4" Grid.Column="0">
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>

					<Button Grid.Row="0" Content="sin" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="sin(" />
					<Button Grid.Row="1" Content="cos" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="cos(" />
					<Button Grid.Row="2" Content="eˣ" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="exp(" />
					<Button Grid.Row="3" Content="ln" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="ln(" />
					
					<Grid.Style>
						<Style TargetType="Grid">
							<Setter Property="Visibility" Value="Hidden" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding CurrentPanel}" Value="SpecialFunctions">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Grid.Style>
				</Grid>

				<Button Grid.Row="5" Grid.Column="0" Content="," FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter=","  />

				<Button Grid.Row="1" Grid.Column="1" Content="π" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="pi" />
				<Button Grid.Row="1" Grid.Column="2" Content="e" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PushInputCommand}" CommandParameter="e" />

				<Button Grid.Row="0" Grid.Column="3" Content="C" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding ClearInputCommand}" />
				<Button Grid.Row="1" Grid.Column="3" Content="⌫" FontSize="{DynamicResource ControlFontSize}" Style="{StaticResource DarkButton}" Command="{Binding PopInputCommand}" />
			</Grid>
		</Grid>
	</Grid>
</Window>